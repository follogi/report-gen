# Configurazione Environment Legal AI System
# Copia questo file in .env e modifica i valori secondo necessità

# =============================================================================
# LLM CONFIGURATION - Configurazione provider AI
# =============================================================================

# Provider LLM da utilizzare
# Valori possibili: ollama, claude, openai, groq
LLM_PROVIDER=ollama

# Modello specifico del provider
# Ollama: mistral, llama2, mixtral, codellama
# Claude: claude-3-opus, claude-3-sonnet, claude-3-haiku
# OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
LLM_MODEL=mistral

# Parametri generazione
LLM_TEMPERATURE=0.1          # Controllo creatività (0=deterministico, 1=creativo)
LLM_MAX_TOKENS=4096          # Lunghezza massima risposta
LLM_TOP_P=0.9                # Nucleus sampling
LLM_TIMEOUT=120              # Timeout richieste in secondi

# URL base per Ollama locale
LLM_BASE_URL=http://localhost:11434

# =============================================================================
# API KEYS - Chiavi API per provider cloud
# =============================================================================

# Claude API (Anthropic)
# Ottieni da: https://console.anthropic.com/
# Costo stimato: $3-15 per 1M token input (dipende da modello)
ANTHROPIC_API_KEY=

# OpenAI API
# Ottieni da: https://platform.openai.com/api-keys
# Costo stimato: $10-30 per 1M token input (dipende da modello)
OPENAI_API_KEY=

# Groq API (per Mixtral, Llama velocissimi)
# Ottieni da: https://console.groq.com/
GROQ_API_KEY=

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================

# Base URL per Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Modello Ollama da usare
OLLAMA_MODEL=mistral:latest

# =============================================================================
# CHROMADB & VECTOR STORE
# =============================================================================

# Directory per database vettoriale persistente
CHROMADB_PERSIST_DIR=./vectordb

# =============================================================================
# EMBEDDINGS CONFIGURATION
# =============================================================================

# Modello per embeddings (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cache directory per embeddings
EMBEDDING_CACHE_DIR=./cache/embeddings

# Device per embeddings: cpu o cuda (se hai GPU)
EMBEDDING_DEVICE=cpu

# =============================================================================
# NORMATIVE FETCHER
# =============================================================================

# URL base per Normattiva.it
NORMATTIVA_BASE_URL=https://www.normattiva.it

# Timeout per richieste a Normattiva
NORMATTIVA_TIMEOUT=30

# =============================================================================
# CONFIDENCE & SCORING
# =============================================================================

# Soglie di confidenza per citazioni
CONFIDENCE_HIGH=0.8          # Verde: citazione diretta verificata
CONFIDENCE_MEDIUM=0.5        # Giallo: interpretazione basata su fonti
CONFIDENCE_MIN=0.3           # Rosso: necessita verifica

# =============================================================================
# STREAMLIT UI
# =============================================================================

# Porta server Streamlit
STREAMLIT_SERVER_PORT=8501

# Indirizzo server Streamlit
STREAMLIT_SERVER_ADDRESS=localhost

# =============================================================================
# LOGGING
# =============================================================================

# Livello logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# DEBUG & DEVELOPMENT
# =============================================================================

# Modalità debug (mostra info aggiuntive)
DEBUG=False

# Abilita fallback automatico tra provider LLM
ENABLE_LLM_FALLBACK=true

# =============================================================================
# ESEMPI DI CONFIGURAZIONI
# =============================================================================

# --- SVILUPPO LOCALE (GRATIS) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=mistral
# LLM_BASE_URL=http://localhost:11434

# --- PRODUZIONE CLAUDE SONNET (BILANCIATO) ---
# LLM_PROVIDER=claude
# LLM_MODEL=claude-3-sonnet
# ANTHROPIC_API_KEY=sk-ant-...

# --- PRODUZIONE ECONOMICA (CLAUDE HAIKU) ---
# LLM_PROVIDER=claude
# LLM_MODEL=claude-3-haiku
# ANTHROPIC_API_KEY=sk-ant-...

# --- MASSIMA QUALITÀ (CLAUDE OPUS) ---
# LLM_PROVIDER=claude
# LLM_MODEL=claude-3-opus
# ANTHROPIC_API_KEY=sk-ant-...

# --- OPENAI GPT-4 ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo-preview
# OPENAI_API_KEY=sk-...

# =============================================================================
# NOTE
# =============================================================================
#
# 1. API KEYS: Non committare questo file con API keys reali!
# 2. COSTI: Claude Haiku è ~10x più economico di Sonnet
# 3. OLLAMA: Completamente gratis ma richiede risorse locali
# 4. FALLBACK: Consigliato abilitare per produzione (ENABLE_LLM_FALLBACK=true)
# 5. PRIVACY: Tutti i dati restano locali con Ollama
